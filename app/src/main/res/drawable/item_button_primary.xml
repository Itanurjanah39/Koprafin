<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#B9CFC9"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="@color/brandDark" android:endColor="@color/brandGreen"/>
                    <corners android:radius="16dp"/>
                    <padding android:left="16dp" android:right="16dp" android:top="4dp" android:bottom="4dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
