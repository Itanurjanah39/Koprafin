<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F3FBF8" android:centerColor="#E2F6EE" android:endColor="#CDEFE6"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#D5EEE5"/>
        </shape>
    </item>
    <item android:gravity="top|end" android:width="220dp" android:height="220dp" android:top="-70dp" android:right="-80dp">
        <shape android:shape="oval"><solid android:color="#6613B5A8"/></shape>
    </item>
    <item android:gravity="bottom|end" android:width="160dp" android:height="160dp" android:bottom="-80dp" android:right="40dp">
        <shape android:shape="oval"><solid android:color="#3322C065"/></shape>
    </item>
</layer-list>
