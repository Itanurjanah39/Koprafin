<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-150dp"
            android:layout_marginEnd="-170dp"
            android:background="@drawable/bg_blob" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="80dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_soft">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_v_mail"
                    android:contentDescription="@null"
                    app:tint="@color/brandPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verifikasi kode OTP"
                style="@style/Koprafin.Text.Display" />

            <TextView
                android:id="@+id/tvEmailInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Masukkan 6 digit kode yang kami kirim ke email"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brandPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="-5dp"
                android:layout_marginEnd="-5dp"
                android:gravity="center"
                android:weightSum="6">

                <EditText android:id="@+id/otp1" style="@style/OtpStyle" android:padding="0dp" />
                <EditText android:id="@+id/otp2" style="@style/OtpStyle" android:padding="0dp" />
                <EditText android:id="@+id/otp3" style="@style/OtpStyle" android:padding="0dp" />
                <EditText android:id="@+id/otp4" style="@style/OtpStyle" android:padding="0dp" />
                <EditText android:id="@+id/otp5" style="@style/OtpStyle" android:padding="0dp" />
                <EditText android:id="@+id/otp6" style="@style/OtpStyle" android:padding="0dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                style="@style/Koprafin.Button.Primary"
                android:text="Verifikasi" />

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="Kirim ulang dalam 60 detik"
                android:textSize="13sp"
                android:textColor="@color/greyPrimary" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
