<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottomsheet_rounded"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Simulasi Kredit"
        style="@style/TextTitle_Bold"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Geser untuk memilih lama cicilan"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary" />

    <!-- Harga produk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_mint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Harga produk"
            android:textSize="13sp"
            android:textColor="@color/brandDeep" />

        <TextView
            android:id="@+id/tvHargaValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp0"
            style="@style/TextTitle_Bold"
            android:textSize="15sp"
            android:textColor="@color/brandDeep" />
    </LinearLayout>

    <!-- Tenor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTenorLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:text="Tenor"
            style="@style/Koprafin.Text.FieldLabel"
            android:layout_marginTop="0dp" />

        <TextView
            android:id="@+id/tvTenor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6"
            style="@style/Koprafin.Text.Display"
            android:textSize="32sp"
            android:textColor="@color/brandPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="7dp"
            android:text="bulan"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekTenor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:max="12"
        android:maxHeight="8dp"
        android:minHeight="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:progressDrawable="@drawable/seekbar_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_thumb" />

    <!-- Angsuran -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_hero_gradient"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimasi angsuran / bulan"
            android:textSize="12sp"
            android:textColor="@color/brandOnDarkSoft" />

        <TextView
            android:id="@+id/tvAngsuran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp0"
            style="@style/Koprafin.Text.Display"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nilai final mengikuti persetujuan admin koperasi"
            android:textSize="11sp"
            android:textColor="@color/brandOnDarkSoft" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAjukan"
        android:layout_width="match_parent"
        android:layout_marginTop="22dp"
        style="@style/Koprafin.Button.Primary"
        android:text="Ajukan Kredit" />
</LinearLayout>
