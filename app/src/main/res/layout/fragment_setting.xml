<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".page.main.SettingFragment"
    android:id="@+id/swipeRefresh">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btnAddCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kategori"
                    style="@style/TextTitle_Bold"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddCategory"
                    android:layout_alignParentEnd="true"
                    android:paddingStart="18sp"
                    android:paddingEnd="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tambah Kategori"
                    android:textAllCaps="false"
                    android:background="@drawable/item_button_secondary"
                    android:textColor="@color/white"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategory"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_category"/>

            <RelativeLayout
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btnAddBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Banner"
                    style="@style/TextTitle_Bold"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddBanner"
                    android:layout_alignParentEnd="true"
                    android:paddingStart="18sp"
                    android:paddingEnd="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tambah Banner"
                    android:textAllCaps="false"
                    android:background="@drawable/item_button_secondary"
                    android:textColor="@color/white"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBanner"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:nestedScrollingEnabled="false"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>