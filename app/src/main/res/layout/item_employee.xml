<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:padding="12sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivOption"
            android:layout_width="22dp"
            android:layout_height="18sp"
            android:src="@drawable/ic_more"
            android:layout_alignParentEnd="true"/>

        <LinearLayout
            android:layout_toStartOf="@+id/ivOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/civEmployee"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:civ_circle_background_color="@color/white"
                android:src="@drawable/ic_people" />

            <LinearLayout
                android:layout_marginStart="12dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvNameEmployee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCompany"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PT Adi Jaya"
                    android:textSize="13sp"
                    android:textColor="@color/colorPrimary"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bergabung pada"
                        android:textSize="11sp"
                        android:textColor="@color/greyTextSoft"/>
                    <TextView
                        android:layout_marginStart="6dp"
                        android:id="@+id/tvJoinDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Januari 2025"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
