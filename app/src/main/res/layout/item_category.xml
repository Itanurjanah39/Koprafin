<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_soft"
            android:padding="11dp"
            android:src="@drawable/ic_v_category"
            android:contentDescription="@null"
            app:tint="@color/brandPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNameCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Kategori"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTenor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_mint"
                    android:drawableStart="@drawable/ic_v_calendar"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/brandDark"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="3–12 bulan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/brandDark" />

                <TextView
                    android:id="@+id/tvMargin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_mint"
                    android:backgroundTint="@color/statusBerjalanBg"
                    android:drawableStart="@drawable/ic_v_percent"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/statusBerjalan"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Margin 10%"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/statusBerjalan" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivOption"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_v_more"
            android:contentDescription="Opsi"
            app:tint="@color/greyPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
