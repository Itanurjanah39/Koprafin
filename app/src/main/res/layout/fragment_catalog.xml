<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llEmptyCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/empty_data"
                android:contentDescription="Kosong" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Katalog masih kosong"
                style="@style/Koprafin.Text.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tarik ke bawah untuk memuat ulang."
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabCategories"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicator="@drawable/tab_pill"
            app:tabIndicatorGravity="stretch"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorColor="@null"
            app:tabIndicatorAnimationMode="elastic"
            app:tabPaddingStart="18dp"
            app:tabPaddingEnd="18dp"
            app:tabMinWidth="0dp"
            app:tabRippleColor="@null"
            app:tabTextAppearance="@style/CustomTabTextStyle"
            app:tabTextColor="@color/colorTextSecondary"
            app:tabSelectedTextColor="@color/white" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
