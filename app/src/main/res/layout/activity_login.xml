<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".page.login.LoginActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-150dp"
            android:layout_marginEnd="-170dp"
            android:background="@drawable/bg_blob" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="72dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo Koprafin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Selamat datang\nkembali 👋"
                style="@style/Koprafin.Text.Display"
                android:textSize="28sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Masuk ke akun Koprafin untuk mengajukan dan memantau kredit Anda."
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/colorTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Email"
                style="@style/Koprafin.Text.FieldLabel" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Koprafin.Input"
                android:drawableStart="@drawable/ic_v_mail"
                android:hint="nama@perusahaan.com"
                android:inputType="textEmailAddress"
                android:importantForAutofill="yes"
                android:autofillHints="emailAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Kata Sandi"
                style="@style/Koprafin.Text.FieldLabel" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Koprafin.Input"
                    android:paddingEnd="52dp"
                    android:drawableStart="@drawable/ic_v_lock"
                    android:hint="Masukkan kata sandi"
                    android:inputType="textPassword"
                    android:autofillHints="password" />

                <ImageView
                    android:id="@+id/ivShowPass"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:padding="11dp"
                    android:src="@drawable/eye"
                    android:contentDescription="Tampilkan kata sandi"
                    android:alpha="0.6" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:padding="4dp"
                android:text="Lupa kata sandi?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brandPrimary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_marginTop="36dp"
                style="@style/Koprafin.Button.Primary"
                android:text="Masuk" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="Koprafin · By Masfita Tech"
                android:textSize="12sp"
                android:textColor="@color/greyTextSoft" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
